+bool
+graphbrewFlowThrough(const BaseCache &cache, const PacketPtr pkt,
+                     bool &structural_flowthrough)
+{
+    structural_flowthrough = false;
+    if (cache.name().find("l3cache") == std::string::npos)
+        return false;
+    const Addr stream_addr = pkt->req->hasVaddr()
+        ? pkt->req->getVaddr() : pkt->getAddr();
+    const bool flowthrough =
+        replacement_policy::graph::isEcgFlowThroughAddress(stream_addr);
+    if (flowthrough) {
+        static uint64_t traced = 0;
+        static const uint64_t limit = []() {
+            const char *value = std::getenv("ECG_FLOWTHROUGH_TRACE");
+            return value ? std::strtoull(value, nullptr, 10) : 0;
+        }();
+        if (traced++ < limit) {
+            std::fprintf(stderr,
+                "[ECG-FLOWTHROUGH sim=gem5 cache=%s addr=%#llx "
+                "vaddr=%#llx allocate=0]\n",
+                cache.name().c_str(),
+                static_cast<unsigned long long>(pkt->getAddr()),
+                static_cast<unsigned long long>(stream_addr));
+        }
+    }
+    return flowthrough;
+}
