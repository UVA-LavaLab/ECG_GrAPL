+                "vaddr=%#llx size=%u source=%s allocate=0]\n",
                 cache.name().c_str(),
                 static_cast<unsigned long long>(pkt->getAddr()),
-                static_cast<unsigned long long>(stream_addr));
+                static_cast<unsigned long long>(stream_addr),
+                static_cast<unsigned>(pkt->req->getSize()),
+                flag_bypass ? "request-flag" : "range");
         }
     }
     return bypass;
