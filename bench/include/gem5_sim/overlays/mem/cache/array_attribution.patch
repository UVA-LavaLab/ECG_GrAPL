+void
+BaseCache::recordGraphArrayDemandMiss(PacketPtr pkt)
+{
+    using namespace replacement_policy::graph;
+    if (!graphArrayStatsActive ||
+        !pkt || !pkt->req || !pkt->cmd.isDemand()) {
+        return;
+    }
+    const bool has_vaddr = pkt->req->hasVaddr();
+    const auto category = classifyEcgArray(
+        has_vaddr, has_vaddr ? pkt->req->getVaddr() : 0);
+    const auto requestor = pkt->req->requestorId();
+    stats.ecgArrayDemandMisses[
+        static_cast<uint32_t>(category)][requestor]++;
+}
+
+void
+BaseCache::recordGraphArrayMshrMiss(PacketPtr pkt)
+{
+    using namespace replacement_policy::graph;
+    if (!graphArrayStatsActive ||
+        !pkt || !pkt->req || !pkt->cmd.isDemand()) {
+        return;
+    }
+    const bool has_vaddr = pkt->req->hasVaddr();
+    const auto category = classifyEcgArray(
+        has_vaddr, has_vaddr ? pkt->req->getVaddr() : 0);
+    const auto category_index = static_cast<uint32_t>(category);
+    const auto requestor = pkt->req->requestorId();
+    if (pkt->isRead()) {
+        stats.ecgArrayDemandReadMshrMisses[
+            category_index][requestor]++;
+        stats.ecgArrayDemandReadBytes[category_index][requestor] +=
+            pkt->req->isUncacheable() ? pkt->getSize() : blkSize;
+    } else {
+        stats.ecgArrayDemandNonReadMshrMisses[
+            category_index][requestor]++;
+    }
+}
