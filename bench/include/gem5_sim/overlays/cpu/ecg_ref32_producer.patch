   public:
+    void setEcgRef32RecordHint(
+        uint64_t canonical, uint64_t iteration, uint16_t context) override
+    {
+        _ecgRef32Hint.kind = ecg_ref32::InstructionKind::RECORD;
+        _ecgRef32Hint.destination = ecg_ref32::extractDestination(
+            static_cast<uint32_t>(canonical), ecg_ref32::kScaleMaxIdBits);
+        _ecgRef32Hint.sequence = static_cast<uint32_t>(canonical >> 32);
+        _ecgRef32Hint.value = static_cast<uint32_t>(iteration);
+        _ecgRef32Hint.state = static_cast<uint8_t>((iteration >> 32) & 1u);
+        _ecgRef32Hint.context = context;
+    }
+
+    void setEcgRef32LoadHint(
+        uint32_t destination, uint32_t sequence, uint32_t deadline,
+        uint8_t state, uint16_t context) override
+    {
+        _ecgRef32Hint.kind = ecg_ref32::InstructionKind::PROPERTY;
+        _ecgRef32Hint.destination = destination;
+        _ecgRef32Hint.sequence = sequence;
+        _ecgRef32Hint.value = deadline;
+        _ecgRef32Hint.state = state;
+        _ecgRef32Hint.context = context;
+    }
+
+    const ecg_ref32::InstructionHint& ecgRef32Hint() const
+    {
+        return _ecgRef32Hint;
+    }
