        // GraphBrew ECG custom-0 instruction space.
        // Full opcode 0x0b maps to OPCODE5=0x02 because bits [1:0] are 0x3.
        0x02: decode FUNCT3 {
            format EcgExtractOp {
                0x0: decode FUNCT7 {
                    0x00: ecg_extract({{
                        // S10.2-WIDE: mode-6 WIDE mask layout (matches
                        // bench/include/ecg_mode6_builder.h packMaskEpochWide) — the
                        // vestigial dbg/popt fields are reclaimed to widen the prefetch
                        // target to 24 bits (<=16,777,215 ids), fixing the gem5 large-graph
                        // ECG_PFX truncation. dbg/popt are NOT delivered here (ECG_GRASP_POPT
                        // uses the epoch; ECG_RP falls back to degree-based dbg):
                        //   [0:24]   dest_id (demand load vertex)
                        //   [24:40]  next-ref epoch (16 bits)
                        //   [40:64]  prefetch target (24 bits, 0 = no prefetch)
                        uint64_t fat_mask = Rs1;
                        uint32_t dest_id     = static_cast<uint32_t>((fat_mask >>  0) & 0xFFFFFFULL);
                        uint8_t  dbg_tier    = 0;
                        uint8_t  popt_quant  = 0;
                        uint16_t epoch       = static_cast<uint16_t>((fat_mask >> 24) & 0xFFFFULL);
                        uint32_t pfx_target  = static_cast<uint32_t>((fat_mask >> 40) & 0xFFFFFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        // Populate per-vertex metadata table so ECG_RP can
                        // consume the ISA-delivered epoch
                        // CHARGED=0 replacement (dbg/popt default to degree-based).
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, dbg_tier, popt_quant, epoch);
                        // Legacy storage (single-slot mailbox; kept for
                        // back-compat with non-ECG_RP consumers).
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint(
                            dest_id, dbg_tier, popt_quant, 0, epoch,
                            current_epoch, context_id);
                        // Queue the prefetch hint (or fall back to demand
                        // vertex if no prefetch encoded).
                        // Only emit a prefetch hint when
                        // the mode-6 mask encoded a non-zero prefetch target. NO
                        // demand-target fallback (the prior version polluted
                        // utility metrics on sparse graphs where the builder
                        // produces no candidates).
                        if (pfx_target != 0) {
                            gem5::replacement_policy::graph::setPrefetchTargetHint(pfx_target);
                        }
                        Rd = rvZext(dest_id);
                    }});
                    // Tiered two-epoch ReusePlan register delivery:
                    // dest[31:0] | tier[33:32] |
                    // epoch1[48:34] | epoch2[63:49].
                    0x01: ecg_extract2({{
                        uint64_t packed = Rs1;
                        uint32_t dest_id = static_cast<uint32_t>(
                            packed & 0xFFFFFFFFULL);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 4,
                            current_epoch, context_id);
                        Rd = rvZext(dest_id);
                    }});
                    // COMPACT two-epoch ReusePlan delivery. Rs1 holds the 32-bit record
                    // dest[id_bits] | tier[2] | first[eb] | second[eb]; Rs2
                    // holds the loop-invariant format word
                    // (id_bits | epoch_bits << 8). Widening in the decoder is
                    // the whole point: in software it costs about 16
                    // instructions per edge with runtime shift amounts, which
                    // at low DRAM utilisation costs more time than the halved
                    // record saves. The delivered metadata is identical to
                    // ecg_extract2, so the two widths cannot mean different
                    // policies.
                    0x02: ecg_extract2c({{
                        const uint32_t record = static_cast<uint32_t>(Rs1);
                        const uint32_t fmt = static_cast<uint32_t>(Rs2);
                        uint32_t id_bits = fmt & 0x3FU;
                        uint32_t epoch_bits = (fmt >> 8) & 0x3FU;
                        if (id_bits == 0 || id_bits > 32) id_bits = 32;
                        if (epoch_bits == 0 || epoch_bits > 16) epoch_bits = 16;
                        const uint32_t id_mask = (id_bits >= 32)
                            ? 0xFFFFFFFFU : ((1U << id_bits) - 1U);
                        const uint32_t ep_mask = (1U << epoch_bits) - 1U;
                        uint32_t dest_id = record & id_mask;
                        uint8_t c_tier = static_cast<uint8_t>(
                            (record >> id_bits) & 0x3U);
                        uint16_t c_epoch1 = static_cast<uint16_t>(
                            (record >> (id_bits + 2)) & ep_mask);
                        uint16_t c_epoch2 = static_cast<uint16_t>(
                            (record >> (id_bits + 2 + epoch_bits)) & ep_mask);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        // Emit what the DECODER decoded, so it can be diffed
                        // against what the guest expected. Without this the
                        // compact path is only equal to the 64-bit path by
                        // inspection, and a drifting decoder would deliver
                        // plausible epochs while silently changing evictions.
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(
                                static_cast<uint64_t>(dest_id) |
                                (static_cast<uint64_t>(c_tier) << 32) |
                                (static_cast<uint64_t>(c_epoch1) << 34) |
                                (static_cast<uint64_t>(c_epoch2) << 49), 4);
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, c_tier, 0, c_epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, c_tier, c_epoch1, c_epoch2, 4,
                            current_epoch, context_id);
                        Rd = rvZext(dest_id);
                    }});
                }
            }
            // GraphBrew FUSED ecg.load (custom-0, FUNCT3=0x1, I-type): a single
            // instruction that LOADS the 8-byte packed mode-6 WIDE record from
            // mem[rs1+imm] AND side-delivers its epoch + prefetch target to the
            // LLC, returning the demand vertex in rd. Replaces the 3-step demand-
            // load + register-repack + ecg.extract sequence with ONE instruction.
            // Same WIDE layout the register ecg.extract decodes:
            //   [0:24] dest_id  [24:40] epoch(16b)  [40:64] prefetch target(24b)
            format Load {
                0x1: ecg_load({{
                    uint64_t fat_mask = Mem_ud;
                    uint32_t dest_id     = static_cast<uint32_t>((fat_mask >>  0) & 0xFFFFFFULL);
                    uint8_t  dbg_tier    = 0;
                    uint8_t  popt_quant  = 0;
                    uint16_t epoch       = static_cast<uint16_t>((fat_mask >> 24) & 0xFFFFULL);
                    uint32_t pfx_target  = static_cast<uint32_t>((fat_mask >> 40) & 0xFFFFFFULL);
                    uint16_t current_epoch = static_cast<uint16_t>(
                        xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                    uint16_t context_id = static_cast<uint16_t>(
                        xc->readMiscReg(MISCREG_ECG_CONTEXT));
                    gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                        dest_id, dbg_tier, popt_quant, epoch);
                    gem5::replacement_policy::graph::setDecodedEcgExtractHint(
                        dest_id, dbg_tier, popt_quant, 0, epoch,
                        current_epoch, context_id);
                    if (pfx_target != 0) {
                        gem5::replacement_policy::graph::setPrefetchTargetHint(pfx_target);
                    }
                    Rd = rvZext(dest_id);
                }});
            }
            // two-epoch ReusePlan record acquisition. Stream forms are placement-only;
            // non-stream forms retain legacy mailbox delivery. Canonical ReusePlan uses
            // ecg_bind_iload_u32 below to attach metadata to the property request.
            format Load {
                0x3: ecg_flow_load({{
                    Rd = Mem_ud;
                }}, mem_flags=[ECG_FLOWTHROUGH]);
                0x4: ecg_plan_load({{
                    uint64_t packed = Mem_ud;
                    uint32_t dest_id = static_cast<uint32_t>(
                        packed & 0xFFFFFFFFULL);
                    uint8_t tier = static_cast<uint8_t>(
                        (packed >> 32) & 0x3ULL);
                    uint16_t epoch1 = static_cast<uint16_t>(
                        (packed >> 34) & 0x7FFFULL);
                    uint16_t epoch2 = static_cast<uint16_t>(
                        (packed >> 49) & 0x7FFFULL);
                    uint16_t current_epoch = static_cast<uint16_t>(
                        xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                    uint16_t context_id = static_cast<uint16_t>(
                        xc->readMiscReg(MISCREG_ECG_CONTEXT));
                    gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                        dest_id, tier, 0, epoch1);
                    gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                        dest_id, tier, epoch1, epoch2, 4,
                        current_epoch, context_id);
                    Rd = packed;
                }});
                0x5: ecg_flow_weighted_load({{
                    Rd = Mem_uw;
                }}, ea_code={{
                    EA = rvZext(Rs1);
                }}, mem_flags=[ECG_FLOWTHROUGH]);
                0x6: ecg_plan_weighted_load({{
                    uint32_t sidecar = Mem_uw;
                    uint32_t dest_id = static_cast<uint32_t>(Rs2);
                    uint8_t tier = static_cast<uint8_t>(sidecar & 0x3U);
                    uint16_t epoch1 = static_cast<uint16_t>(
                        (sidecar >> 2) & 0x7FFFU);
                    uint16_t epoch2 = static_cast<uint16_t>(
                        (sidecar >> 17) & 0x7FFFU);
                    uint16_t current_epoch = static_cast<uint16_t>(
                        xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                    uint16_t context_id = static_cast<uint16_t>(
                        xc->readMiscReg(MISCREG_ECG_CONTEXT));
                    gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                        dest_id, tier, 0, epoch1);
                    gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                        dest_id, tier, epoch1, epoch2, 4,
                        current_epoch, context_id);
                    Rd = sidecar;
                }}, ea_code={{
                    uint64_t dest_dependency = Rs2;
                    (void)dest_dependency;
                    EA = rvZext(Rs1);
                }});
                // Compact unweighted FlowThrough record load. Memory moves
                // four bytes, while rd receives the canonical
                // dest32|tier2|epoch1_15|epoch2_15 mask consumed by ReuseBind.
                // Field widths are loop-invariant architectural state in CSR
                // 0x802, written before the ROI.
                0x7: ecg_flow_load_compact({{
                    const uint64_t compact =
                        static_cast<uint32_t>(Mem_uw);
                    const uint32_t fmt = static_cast<uint32_t>(
                        xc->readMiscReg(MISCREG_ECG_RECORD_FORMAT));
                    const uint32_t id_bits = fmt & 0x3FU;
                    const uint32_t epoch_bits = (fmt >> 8) & 0x3FU;
                    panic_if(
                        id_bits == 0 || epoch_bits == 0 ||
                        id_bits + 2 + 2 * epoch_bits > 32,
                        "Invalid compact FlowThrough ReusePlan format: "
                        "id_bits=%u epoch_bits=%u",
                        id_bits, epoch_bits);
                    const uint64_t id_mask =
                        (uint64_t{1} << id_bits) - 1;
                    const uint64_t epoch_mask =
                        (uint64_t{1} << epoch_bits) - 1;
                    const uint32_t dest_id = static_cast<uint32_t>(
                        compact & id_mask);
                    const uint8_t tier = static_cast<uint8_t>(
                        (compact >> id_bits) & 0x3U);
                    const uint16_t epoch1 = static_cast<uint16_t>(
                        (compact >> (id_bits + 2)) & epoch_mask);
                    const uint16_t epoch2 = static_cast<uint16_t>(
                        (compact >> (id_bits + 2 + epoch_bits)) &
                        epoch_mask);
                    Rd =
                        static_cast<uint64_t>(dest_id) |
                        (static_cast<uint64_t>(tier) << 32) |
                        (static_cast<uint64_t>(epoch1) << 34) |
                        (static_cast<uint64_t>(epoch2) << 49);
                }}, mem_flags=[ECG_FLOWTHROUGH]);
            }
            // GraphBrew FUSED ecg.load (custom-0, FUNCT3=0x2, R-type): indexed-
            // property load + metadata delivery in ONE op. rs1 = property base, rs2 =
            // fat edge record. EA = rs1 + dest*4; loads property[dest]; delivers the
            // caching metadata in ea_code (BEFORE the access) so the line is stamped on
            // fill; rd = property value. FUNCT7 = ECG_MODE<31:27> | ECG_WIDTH<26:25>:
            // the MODE picks the caching axis; for EVICT/PFX the WIDTH class selects the
            // dest field width W = 8/16/24/32 bits (epoch rides [W:W+16]), so one op
            // scales from 256 to 4.29B vertices. Bit layouts follow ecg_mode6_builder.h.
            format Load {
                0x2: decode ECG_MODE {
                    // 0x00 EVICT (WIDE, configurable dest): dest[0:W] | epoch[W:W+16].
                    0x00: ecg_load_evict({{
                        Rd = Mem_uw;
                    }}, ea_code={{
                        uint64_t fat = Rs2;
                        unsigned W = 8u * (ECG_WIDTH + 1);              // 8/16/24/32
                        uint64_t dmask = (W >= 32) ? 0xFFFFFFFFULL : ((1ULL << W) - 1);
                        uint32_t dest_id = static_cast<uint32_t>(fat & dmask);
                        uint16_t epoch   = static_cast<uint16_t>((fat >> W) & 0xFFFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, 0, 0, epoch);
                        // Also populate the single-slot mailbox: ECG_GRASP_POPT stamps
                        // property fills from lookupDecodedEcgHint (ecg_rp.cc), NOT the
                        // per-vertex table — without this the epoch never reaches the line.
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint(
                            dest_id, 0, 0, 0, epoch,
                            current_epoch, context_id);
                        // GraphBrew ECG producer: stash {dest,epoch} on THIS dynamic inst so
                        // the LSQ binds it to this ecg.load's own demand Request (race-free
                        // O3 delivery). No-op on in-order CPUs (default ExecContext hook).
                        xc->setEcgLoadHint(
                            dest_id, epoch, 0, 0,
                            current_epoch, context_id);
                        EA = rvZext(Rs1 + static_cast<uint64_t>(dest_id) * 4);
                    }});
                    // 0x01 EVICT+PFX (WIDE, configurable): dest[0:W] | epoch[W:W+16] | pfx[W+16:64].
                    0x01: ecg_load_pfx({{
                        Rd = Mem_uw;
                    }}, ea_code={{
                        uint64_t fat = Rs2;
                        unsigned W = 8u * (ECG_WIDTH + 1);
                        uint64_t dmask = (W >= 32) ? 0xFFFFFFFFULL : ((1ULL << W) - 1);
                        uint32_t dest_id = static_cast<uint32_t>(fat & dmask);
                        uint16_t epoch   = static_cast<uint16_t>((fat >> W) & 0xFFFFULL);
                        uint32_t pfx     = static_cast<uint32_t>((fat >> (W + 16)) & 0xFFFFFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, 0, 0, epoch);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint(
                            dest_id, 0, 0, 0, epoch,
                            current_epoch, context_id);
                        if (pfx != 0) {
                            gem5::replacement_policy::graph::setPrefetchTargetHint(pfx);
                        }
                        // GraphBrew ECG producer (see ecg_load_evict): race-free O3 delivery.
                        xc->setEcgLoadHint(
                            dest_id, epoch, 0, 0,
                            current_epoch, context_id);
                        EA = rvZext(Rs1 + static_cast<uint64_t>(dest_id) * 4);
                    }});
                    // 0x02 EMBEDDED (NARROW packMaskEpoch, fixed 24-bit dest, dbg-carrying):
                    // dest[0:24] | dbg[24:26] | popt[26:33] | epoch[33:49] | pfx[49:64].
                    0x02: ecg_load_embedded({{
                        Rd = Mem_uw;
                    }}, ea_code={{
                        uint64_t fat = Rs2;
                        uint32_t dest_id = static_cast<uint32_t>(fat & 0xFFFFFFULL);
                        uint8_t  dbg     = static_cast<uint8_t> ((fat >> 24) & 0x3ULL);
                        uint8_t  popt    = static_cast<uint8_t> ((fat >> 26) & 0x7FULL);
                        uint16_t epoch   = static_cast<uint16_t>((fat >> 33) & 0xFFFFULL);
                        uint32_t pfx     = static_cast<uint32_t>((fat >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, dbg, popt, epoch);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint(
                            dest_id, dbg, popt, 0, epoch,
                            current_epoch, context_id);
                        if (pfx != 0) {
                            gem5::replacement_policy::graph::setPrefetchTargetHint(pfx);
                        }
                        // GraphBrew ECG producer (see ecg_load_evict): race-free O3 delivery.
                        xc->setEcgLoadHint(
                            dest_id, epoch, dbg, popt,
                            current_epoch, context_id);
                        EA = rvZext(Rs1 + static_cast<uint64_t>(dest_id) * 4);
                    }});
                    // 0x03 ReusePlan: dest32 | tier2 | epoch1_15 | epoch2_15.
                    // The graph mask rides the governed property-load Request.
                    0x03: ecg_bind_iload_u32({{
                        Rd = Mem_uw;
                        // The cache fill/hit consumes the mailbox before
                        // completeAcc executes. Clear here so private-cache hits
                        // cannot leave metadata for a later plain property load.
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(packed);
                        uint32_t dest_id = static_cast<uint32_t>(
                            packed & 0xFFFFFFFFULL);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 4,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(
                            Rs1 + static_cast<uint64_t>(dest_id) * 4);
                    }});
                    // 0x04 ReusePlan-U64: same mask, governed 8-byte property load.
                    0x04: ecg_bind_iload_u64({{
                        Rd = Mem_ud;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(packed, 8);
                        uint32_t dest_id = static_cast<uint32_t>(
                            packed & 0xFFFFFFFFULL);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 8,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(
                            Rs1 + static_cast<uint64_t>(dest_id) * 8);
                    }});
                    // 0x05 compact weighted ReusePlan:
                    // dest24 | weight8 | tier2 | epoch1_15 | epoch2_15.
                    0x05: ecg_bind_iload_cw24({{
                        Rd = Mem_uw;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedCompactWeightedEcgHint2(packed);
                        uint32_t dest_id = static_cast<uint32_t>(
                            packed & 0x00FFFFFFULL);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 4,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(
                            Rs1 + static_cast<uint64_t>(dest_id) * 4);
                    }});
                    // 0x06 ReuseBind U32.D32: rs1 is the already-computed property
                    // address; rs2 carries dest32|tier2|epoch1_15|epoch2_15.
                    0x06: ecg_bind_load_u32({{
                        Rd = Mem_uw;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(packed);
                        uint32_t dest_id = static_cast<uint32_t>(packed);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 4,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(Rs1);
                    }});
                    // 0x07 ReuseBind S32.D32.
                    0x07: ecg_bind_load_s32({{
                        Rd_sd = Mem_sw;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(packed);
                        uint32_t dest_id = static_cast<uint32_t>(packed);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 4,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(Rs1);
                    }});
                    // 0x08 ReuseBind U64.D32.
                    0x08: ecg_bind_load_u64({{
                        Rd = Mem_ud;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(packed, 8);
                        uint32_t dest_id = static_cast<uint32_t>(packed);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 8,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(Rs1);
                    }});
                    // 0x09 ReuseBind U32.CW24: compact weighted record.
                    0x09: ecg_bind_load_cw24({{
                        Rd = Mem_uw;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedCompactWeightedEcgHint2(packed);
                        uint32_t dest_id = static_cast<uint32_t>(
                            packed & 0x00FFFFFFULL);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 4,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(Rs1);
                    }});
                    // 0x0A ReuseBind F32.D32: bit-preserving FP property load.
                    0x0A: ecg_bind_load_f32({{
                        STATUS status = xc->readMiscReg(MISCREG_STATUS);
                        if (status.fs == FPUStatus::OFF)
                            return std::make_shared<IllegalInstFault>(
                                "FPU is off", machInst);
                        status.fs = FPUStatus::DIRTY;
                        xc->setMiscReg(MISCREG_STATUS, status);
                        freg_t fd = freg(f32(Mem_uw));
                        Fd_bits = fd.v;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        uint64_t packed = Rs2;
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(packed);
                        uint32_t dest_id = static_cast<uint32_t>(packed);
                        uint8_t tier = static_cast<uint8_t>(
                            (packed >> 32) & 0x3ULL);
                        uint16_t epoch1 = static_cast<uint16_t>(
                            (packed >> 34) & 0x7FFFULL);
                        uint16_t epoch2 = static_cast<uint16_t>(
                            (packed >> 49) & 0x7FFFULL);
                        uint16_t current_epoch = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        uint16_t context_id = static_cast<uint16_t>(
                            xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::storeEcgMetadataByVertex(
                            dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::setDecodedEcgExtractHint2(
                            dest_id, tier, epoch1, epoch2, 4,
                            current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(Rs1);
                    }}, inst_flags=FloatMemReadOp);
                    // 0x0B ReusePlan-Compact: fused 4-byte property load with a COMPACT
                    // 32-bit two-epoch ReusePlan record in Rs2. The record format is
                    // architectural state in CSR 0x802:
                    //   fmt[5:0]   = id_bits
                    //   fmt[13:8]  = epoch_bits
                    // The CSR is written once before the ROI, so the hot path
                    // remains one record load plus one governed property load.
                    0x0B: decode ECG_WIDTH {
                    0x0: ecg_bind_iload_compact({{
                        Rd = Mem_uw;
                        gem5::replacement_policy::graph::
                            clearDecodedEcgExtractHint();
                    }}, ea_code={{
                        const uint64_t compact =
                            static_cast<uint32_t>(Rs2);
                        const uint32_t fmt = static_cast<uint32_t>(
                            xc->readMiscReg(MISCREG_ECG_RECORD_FORMAT));
                        const uint32_t id_bits = fmt & 0x3FU;
                        const uint32_t epoch_bits = (fmt >> 8) & 0x3FU;
                        panic_if(
                            id_bits == 0 || epoch_bits == 0 ||
                            id_bits + 2 + 2 * epoch_bits > 32,
                            "Invalid compact ReusePlan record format: id_bits=%u "
                            "epoch_bits=%u", id_bits, epoch_bits);

                        const uint64_t id_mask =
                            (uint64_t{1} << id_bits) - 1;
                        const uint64_t epoch_mask =
                            (uint64_t{1} << epoch_bits) - 1;
                        const uint32_t dest_id = static_cast<uint32_t>(
                            compact & id_mask);
                        const uint8_t tier = static_cast<uint8_t>(
                            (compact >> id_bits) & 0x3U);
                        const uint16_t epoch1 = static_cast<uint16_t>(
                            (compact >> (id_bits + 2)) & epoch_mask);
                        const uint16_t epoch2 = static_cast<uint16_t>(
                            (compact >> (id_bits + 2 + epoch_bits)) &
                            epoch_mask);
                        const uint64_t canonical =
                            static_cast<uint64_t>(dest_id) |
                            (static_cast<uint64_t>(tier) << 32) |
                            (static_cast<uint64_t>(epoch1) << 34) |
                            (static_cast<uint64_t>(epoch2) << 49);
                        gem5::replacement_policy::graph::
                            traceExpectedEcgExtractHint2(canonical);

                        const uint16_t current_epoch =
                            static_cast<uint16_t>(
                                xc->readMiscReg(MISCREG_ECG_CUR_EPOCH));
                        const uint16_t context_id =
                            static_cast<uint16_t>(
                                xc->readMiscReg(MISCREG_ECG_CONTEXT));
                        gem5::replacement_policy::graph::
                            storeEcgMetadataByVertex(
                                dest_id, tier, 0, epoch1);
                        gem5::replacement_policy::graph::
                            setDecodedEcgExtractHint2(
                                dest_id, tier, epoch1, epoch2, 4,
                                current_epoch, context_id);
                        xc->setEcgLoadHint2(
                            dest_id, tier, epoch1, epoch2,
                            current_epoch, context_id);
                        EA = rvZext(
                            Rs1 + static_cast<uint64_t>(dest_id) * 4);
                    }});
                    }
                }
            }
        }
