#!/bin/bash
#SBATCH --job-name=ecg-final
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#SBATCH --time=3-00:00:00
#SBATCH --exclusive
#SBATCH --output=results/slurm_logs/ecg_%A_%a.out
#SBATCH --error=results/slurm_logs/ecg_%A_%a.err
# Set these for your UVA allocation if needed:
# #SBATCH --account=<uva-allocation>
# #SBATCH --partition=<uva-partition>

set -euo pipefail

if [[ "$#" -ne 0 ]]; then
  echo "This wrapper accepts configuration through declared environment variables, not command-line arguments" >&2
  exit 2
fi

mode="${GRAPHBREW_SLURM_MODE:-legacy-shard}"
if [[ "$mode" != "legacy-shard" && "$mode" != "current-whole-profile" ]]; then
  echo "Invalid GRAPHBREW_SLURM_MODE=${mode}; expected legacy-shard or current-whole-profile" >&2
  exit 2
fi

cd "${GRAPHBREW_ROOT:-$PWD}"
if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
fi
mkdir -p results/slurm_logs

if [[ "$mode" == "current-whole-profile" ]]; then
  if [[ -n "${SLURM_ARRAY_TASK_ID:-}" ]]; then
    echo "CURRENT WHOLE-PROFILE mode is a serial single job and must not use sbatch --array" >&2
    exit 2
  fi
  profile="${GRAPHBREW_CURRENT_PROFILE:-}"
  run_tag="${GRAPHBREW_CURRENT_RUN_TAG:-}"
  if [[ -z "$profile" ]]; then
    echo "GRAPHBREW_CURRENT_PROFILE is required in CURRENT WHOLE-PROFILE mode" >&2
    exit 2
  fi
  if [[ "$profile" != "ecg_current_equivalence" &&
        "$profile" != "ecg_local_release_cache" &&
        "$profile" != "ecg_twitter_reproduction" &&
        "$profile" != "ecg_large_cache" &&
        "$profile" != "ecg_detailed_final" ]]; then
    echo "Unsupported CURRENT WHOLE-PROFILE profile: $profile" >&2
    exit 2
  fi
  if [[ -z "$run_tag" ]]; then
    echo "GRAPHBREW_CURRENT_RUN_TAG is required in CURRENT WHOLE-PROFILE mode" >&2
    exit 2
  fi
  if [[ ! "$run_tag" =~ ^[A-Za-z0-9._-]+$ || "$run_tag" == "." || "$run_tag" == ".." ]]; then
    echo "Invalid GRAPHBREW_CURRENT_RUN_TAG: use only letters, digits, dot, underscore, and hyphen" >&2
    exit 2
  fi
  if [[ -n "${GRAPHBREW_SCREEN_GATE:-}" ]]; then
    echo "CURRENT WHOLE-PROFILE mode does not accept a historical screen receipt via GRAPHBREW_SCREEN_GATE" >&2
    exit 2
  fi

  run_dir="results/ecg_experiments/runs/slurm/${run_tag}/${profile}"
  current_args=(
    --profile "$profile"
    --run-dir "$run_dir"
    --graph-dir "${GRAPHBREW_GRAPH_DIR:-results/graphs}"
    --lock-path "results/ecg_experiments/runs/slurm/${run_tag}/${profile}/.experiment_run.lock"
    --no-build
  )
  preflight_args=(--profile "$profile")
  if [[ "$profile" == "ecg_current_equivalence" || "$profile" == "ecg_detailed_final" ]]; then
    preflight_args+=(--probe-fuse)
  fi
  if [[ "$profile" == "ecg_detailed_final" ]]; then
    if [[ "${GRAPHBREW_FINAL_STAGE:-}" != "1" ]]; then
      echo "ecg_detailed_final requires explicit GRAPHBREW_FINAL_STAGE=1" >&2
      exit 2
    fi
    if [[ -z "${GRAPHBREW_EQUIVALENCE_RECEIPT:-}" ]]; then
      echo "ecg_detailed_final requires GRAPHBREW_EQUIVALENCE_RECEIPT" >&2
      exit 2
    fi
    if [[ ! -r "$GRAPHBREW_EQUIVALENCE_RECEIPT" ]]; then
      echo "GRAPHBREW_EQUIVALENCE_RECEIPT is not readable: $GRAPHBREW_EQUIVALENCE_RECEIPT" >&2
      exit 2
    fi
    current_args+=(
      --final-stage
      --equivalence-receipt "$GRAPHBREW_EQUIVALENCE_RECEIPT"
    )
    preflight_args+=(--equivalence-receipt "$GRAPHBREW_EQUIVALENCE_RECEIPT")
  elif [[ -n "${GRAPHBREW_FINAL_STAGE:-}" ||
          -n "${GRAPHBREW_EQUIVALENCE_RECEIPT:-}" ]]; then
    echo "Final-stage intent and equivalence receipts are accepted only for ecg_detailed_final" >&2
    exit 2
  fi

  mkdir -p "$run_dir"
  python3 -I scripts/test/sniper_rss_watch.py \
    --rss-mib 512 --seconds 60 --log "$run_dir/lab_preflight.log" -- \
    python3 -I scripts/experiments/ecg/flows/lab_runtime_preflight.py "${preflight_args[@]}"
  GRAPHBREW_SHARD_GROUP="$run_tag" \
  python3 -I scripts/experiments/ecg/flows/experiment_run.py \
    "${current_args[@]}"
  exit $?
fi

if [[ -z "${SHARDS:-}" ]]; then
  echo "SHARDS must point to the TSV generated by slurm/make_slurm_shards.py" >&2
  exit 2
fi
if [[ -z "${SLURM_ARRAY_TASK_ID:-}" ]]; then
  echo "SLURM_ARRAY_TASK_ID must be set by sbatch --array" >&2
  exit 2
fi
if [[ ! "$SLURM_ARRAY_TASK_ID" =~ ^[0-9]+$ ]]; then
  echo "SLURM_ARRAY_TASK_ID must be a non-negative integer" >&2
  exit 2
fi
if [[ ! -r "$SHARDS" ]]; then
  echo "SHARDS is not readable: $SHARDS" >&2
  exit 2
fi

line_number=$((SLURM_ARRAY_TASK_ID + 1))
line=$(sed -n "${line_number}p" "$SHARDS")
if [[ -z "$line" ]]; then
  echo "No shard row for SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID}" >&2
  exit 3
fi

field_count=$(awk -F '\t' '{print NF; exit}' <<< "$line")
if [[ "$field_count" -ne 6 ]]; then
  echo "Invalid shard row ${line_number}: expected 6 tab-separated fields, got ${field_count}" >&2
  echo "$line" >&2
  exit 4
fi
IFS=$'\t' read -r profile stage graph benchmark policy run_tag <<< "$line"
if [[ -z "$profile" ]]; then
  echo "Invalid shard row ${line_number}: empty profile" >&2
  exit 4
fi
if [[ -z "$stage" ]]; then
  echo "Invalid shard row ${line_number}: empty stage" >&2
  exit 4
fi
if [[ -z "$graph" ]]; then
  echo "Invalid shard row ${line_number}: empty graph" >&2
  exit 4
fi
if [[ -z "$benchmark" ]]; then
  echo "Invalid shard row ${line_number}: empty benchmark" >&2
  exit 4
fi
if [[ -z "$policy" ]]; then
  echo "Invalid shard row ${line_number}: empty policy" >&2
  exit 4
fi
if [[ -z "$run_tag" ]]; then
  echo "Invalid shard row ${line_number}: empty run_tag" >&2
  exit 4
fi
if [[ ! "$profile" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid shard row ${line_number}: invalid profile" >&2
  exit 4
fi
if [[ ! "$stage" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid shard row ${line_number}: invalid stage" >&2
  exit 4
fi
if [[ ! "$graph" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid shard row ${line_number}: invalid graph" >&2
  exit 4
fi
if [[ ! "$benchmark" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid shard row ${line_number}: invalid benchmark" >&2
  exit 4
fi
if [[ ! "$policy" =~ ^[A-Za-z0-9._:+-]+$ ]]; then
  echo "Invalid shard row ${line_number}: invalid policy" >&2
  exit 4
fi
if [[ ! "$run_tag" =~ ^[A-Za-z0-9._-]+$ || "$run_tag" == "." || "$run_tag" == ".." ]]; then
  echo "Invalid shard row ${line_number}: invalid run_tag" >&2
  exit 4
fi
if [[ "$profile" == "ecg_current_equivalence" ||
      "$profile" == "ecg_local_release_cache" ||
      "$profile" == "ecg_twitter_reproduction" ||
      "$profile" == "ecg_large_cache" ||
      "$profile" == "ecg_detailed_final" ]]; then
  echo "Profile $profile requires GRAPHBREW_SLURM_MODE=current-whole-profile and cannot run as a legacy shard" >&2
  exit 4
fi
safe_policy=${policy//:/_}
safe_stage=${stage//:/_}
run_dir="results/ecg_experiments/runs/slurm/${run_tag}/${profile}_${safe_stage}_${graph}_${benchmark}_${safe_policy}"

policy_args=()
if [[ "$policy" != "__whole__" ]]; then
  policy_args=(--policy "$policy")
fi
screen_gate_args=()
if [[ -n "${GRAPHBREW_SCREEN_GATE:-}" ]]; then
  screen_gate_args=(--screen-gate "$GRAPHBREW_SCREEN_GATE")
fi

GRAPHBREW_SHARD_GROUP="$run_tag" \
python3 scripts/experiments/ecg/flows/experiment_run.py \
  --profile "$profile" \
  --run-dir "$run_dir" \
  --graph-dir "${GRAPHBREW_GRAPH_DIR:-results/graphs}" \
  --only "$stage" \
  --graph "$graph" \
  --benchmark "$benchmark" \
  "${policy_args[@]}" \
  "${screen_gate_args[@]}" \
  --lock-path "$run_dir/.experiment_run.lock" \
  --no-build
