  "popt_model": {
    "epochs": 256,
    "property_bytes": 4,
    "reserved_column_slots": 2,
    "expected_reserved_ways_in_screen": 1,
    "expected_effective_data_ways_in_screen": 15,
    "minimum_data_ways": 1,
    "reload_each_iteration": true,
    "charge_initial_columns_in_roi": true,
    "screen_stream_charge": "analytic_cumulative_offchip",
    "timing_treatment": "optimistic_no_stream_latency",
    "note": "The screen simulates P-OPT replacement with the computed reserved LLC capacity and charges every matrix byte for every PageRank iteration as off-chip traffic. Matrix-stream latency is omitted, which favors P-OPT. Triple buffering costs one additional LLC way versus a two-slot design; target-time and two-slot serialized sensitivities remain mandatory before a P-OPT performance claim."
  },
