<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="ecg-paper-f05-flowthrough" name="FlowThrough separates service from LLC fill allocation" ecgTitle="FlowThrough separates service from LLC fill allocation" ecgDescription="Lookup and service stay unchanged: translation, load ordering, private and last-level lookup, hits, miss service, responses, and writeback. A hit bypasses fill allocation. On a miss, each MSHR target contributes an allocation bit; an all-no-allocate target list skips the LLC fill, while any allocating merge target forces the fill.">
    <mxGraphModel dx="1200" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0" background="none"><root>
