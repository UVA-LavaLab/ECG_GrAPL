<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="home-f01-system-overview" name="ECG: graph knowledge in the edge stream" ecgTitle="ECG: graph knowledge in the edge stream" ecgDescription="The same graph access is followed from vertex eight and CSR position eighteen to a richer Full14 mask or a compact Scale6 token, normal property addressing, and a resident-line update. The property value is unchanged. A teaching cache contrasts recency with carried future reuse. Scale6 is the large-ID format, not the complete ECG design.">
