      <mxCell id="t103" value="The cache comparison is a worked two-way example, not a benchmark result. Data bytes stay unchanged." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1074.24" width="848.00" height="22.40" as="geometry"/></mxCell>
