      <mxCell id="t099" value="The same edge is 0x10000012 in the 26+6 ABI; its distance-four hint decodes to seven." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1208.24" width="720.80" height="22.40" as="geometry"/></mxCell>
