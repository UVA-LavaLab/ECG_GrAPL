      <mxCell id="t055" value="bucket = floor(log2(distance)); decode upper bound = 2^(bucket + 1) - 1." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="785.24" width="610.56" height="22.40" as="geometry"/></mxCell>
