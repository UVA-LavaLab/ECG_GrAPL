      <mxCell id="t059" value="DO NOT MIX FORMAT CLAIMS" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=22;fontColor=#182230;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74.00" y="876.08" width="300.96" height="30.80" as="geometry"/></mxCell>
