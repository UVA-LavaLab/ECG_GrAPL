<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="reuse-plan-flowthrough-f02-record-formats" name="Choose the mask to fit the graph" ecgTitle="Choose the mask to fit the graph" ecgDescription="A thirty-two-bit edge word has 32 minus the required ID width spare bits. The running thirty-two-vertex graph needs five ID bits and its Full14 example uses fourteen metadata bits, leaving thirteen unused. Full14 supports configurable reference/state/action splits totaling fourteen bits. Twitter requires twenty-six ID bits and uses Scale6. The current native ABI is explicitly fixed to twenty-six plus six.">
    <mxGraphModel dx="1200" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1320" math="0" shadow="0" background="none"><root>
