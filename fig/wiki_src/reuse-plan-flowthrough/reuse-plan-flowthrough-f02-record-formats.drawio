      <mxCell id="t101" value="A full 32-bit vertex ID leaves no metadata in a 32-bit word, so the record becomes 8 bytes with M=32." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1176.24" width="856.48" height="22.40" as="geometry"/></mxCell>
      <mxCell id="t102" value="The loader may force 4 or 8 bytes, or try 4 then 8 while enforcing minimum mantissa precision." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1208.24" width="797.12" height="22.40" as="geometry"/></mxCell>
      <mxCell id="t103" value="The 26-ID/M6/H31/m0 case reproduces the old compact bytes only as a numeric configuration." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1240.24" width="763.20" height="22.40" as="geometry"/></mxCell>
      <mxCell id="t104" value="An eight-byte record alone is not evidence of exascale graph-loader support." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#475467;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1272.24" width="644.48" height="22.40" as="geometry"/></mxCell>
