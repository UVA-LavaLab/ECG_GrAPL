<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="reuse-plan-flowthrough-f01-offline-construction" name="Building Scale6 records in traversal order" ecgTitle="Building Scale6 records in traversal order" ecgDescription="An undirected fixture is traversed as PageRank pull. Its source adjacency 4 to 7 maps to internal row 8 and property vertex 18. Flattening the rows locates edge positions 18 and 22 as successive accesses to the same property line. Their distance four becomes token four, packed with vertex 18 as 0x10000012. The production directed builder uses two line-indexed arrays.">
    <mxGraphModel dx="1200" dy="1170" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1170" math="0" shadow="0" background="none"><root>
