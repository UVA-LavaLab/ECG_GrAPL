<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="reuse-plan-flowthrough-f06-capacity-accounting" name="Graph-sized matrices and cache-sized state" ecgTitle="Graph-sized matrices and cache-sized state" ecgDescription="For full Twitter, one one-byte-per-property-line column is 2,603,265 bytes. Full P-OPT keeps two columns and SE keeps one, while both retain 256 backing columns. Sixteen-way bars show the full and single-epoch reservations at 8, 16 and 24 MiB. Full14&#x27;s default twenty-one-bit deadline and Scale6&#x27;s thirty-two-bit deadline produce different cache-sized metadata budgets. Neither model count is a silicon-area ratio.">
