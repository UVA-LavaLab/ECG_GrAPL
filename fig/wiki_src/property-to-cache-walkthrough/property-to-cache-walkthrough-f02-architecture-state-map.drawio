<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="property-to-cache-walkthrough-f02-architecture-state-map" name="Where Scale6 metadata lives" ecgTitle="Where Scale6 metadata lives" ecgDescription="An outer memory region contains the CSR offsets, packed Scale6 records and ordinary property arrays. Preprocessing scratch is temporary. The runtime model contains bounded commit and prefetch queues plus a 16-record lookahead, and each LLC line holds 35 added bits. The 8 MiB example totals 4,590,584 bits of added state, not a silicon-area measurement.">
