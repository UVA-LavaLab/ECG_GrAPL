      <mxCell id="t121" value="8 MiB model totals: Full14 3,148,352 bits; Scale6 4,590,584 bits. Baseline cache data/tags remain separate." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1336.24" width="907.36" height="22.40" as="geometry"/></mxCell>
      <mxCell id="t122" value="Native capture, validation, port logic and planned 128-byte lookahead require their own cost accounting." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#475467;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1368.24" width="881.92" height="22.40" as="geometry"/></mxCell>
