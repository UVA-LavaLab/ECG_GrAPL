<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="property-to-cache-walkthrough-f02-architecture-state-map" name="Where the mask and its decoded state live" ecgTitle="Where the mask and its decoded state live" ecgDescription="The encoded edge record and ordinary property data reside in separate graph-memory arrays. Current builders retain the source graph, allocate a vector&lt;uint32_t&gt; or vector&lt;uint64_t&gt; carrier, and use a sparse line-indexed first/next map rather than edge-sized action arrays. Native per-instruction state is bounded by the CPU window. Resident prediction payload is 67 logical bits per cache line.">
    <mxGraphModel dx="1200" dy="1430" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1430" math="0" shadow="0" background="none"><root>
