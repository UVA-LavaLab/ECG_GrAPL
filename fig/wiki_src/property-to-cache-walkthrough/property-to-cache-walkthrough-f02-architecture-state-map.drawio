<mxfile host="app.diagrams.net" agent="ECG deterministic figure generator" type="device" compressed="false">
  <diagram id="property-to-cache-walkthrough-f02-architecture-state-map" name="Where the mask and its decoded state live" ecgTitle="Where the mask and its decoded state live" ecgDescription="The encoded edge record and ordinary property data reside in graph memory. Full14&#x27;s functional path keeps a separate carrier; in-place Scale6 avoids another edge array. Native per-instruction state is bounded by the CPU&#x27;s in-flight window. Functional runtime accounting includes bounded commit and prefetch queues, a sixteen-word lookahead and D plus three prediction bits per cache line. D=21 and D=32 are shown separately rather than treating the Scale6 cost as universal.">
    <mxGraphModel dx="1200" dy="1430" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1430" math="0" shadow="0" background="none"><root>
