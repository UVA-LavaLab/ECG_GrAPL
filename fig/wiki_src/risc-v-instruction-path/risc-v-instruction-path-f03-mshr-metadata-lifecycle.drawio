      <mxCell id="t085" value="Apply only to the matching resident line. Expired update -&gt; discard; invalidated line -&gt; no allocation." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#182230;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="976.24" width="873.44" height="22.40" as="geometry"/></mxCell>
      <mxCell id="t086" value="A stale finite prediction becomes UNKNOWN when resolved. It must never become falsely DEAD." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Liberation Sans;fontSize=16;fontColor=#C63C4A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.00" y="1011.24" width="771.68" height="22.40" as="geometry"/></mxCell>
